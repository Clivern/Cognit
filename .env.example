# DigitalOcean Container Registry image
COGNIT_IMAGE=registry.digitalocean.com/cognit/cognit:main

# Public URL (used in emails, billing redirects, etc.)
COGNIT_SERVER_URL=http://localhost

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cognit

# Nginx
NGINX_HTTP_PORT=80

# Optional: AI, mail, billing, GitHub/Google OAuth
# COGNIT_AI_OROUTE_API_KEY=
# COGNIT_RESEND_API_KEY=
# COGNIT_STRIPE_SECRET_KEY=
# COGNIT_STRIPE_WEBHOOK_SECRET=
# COGNIT_GITHUB_OAUTH_CLIENT_ID=
# COGNIT_GITHUB_OAUTH_CLIENT_SECRET=
# COGNIT_GITHUB_OAUTH_REDIRECT_URL=
# COGNIT_GOOGLE_OAUTH_CLIENT_ID=
# COGNIT_GOOGLE_OAUTH_CLIENT_SECRET=
# COGNIT_GOOGLE_OAUTH_REDIRECT_URL=
